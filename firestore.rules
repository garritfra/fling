rules_version = '2';

// Grundregel: Alles liegt unter households/{householdId}/. Zugriff hat, wer in memberUids steht.
// Einzige haushaltsübergreifende Daten: invites/{code}.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function householdPath(hid) {
      return /databases/$(database)/documents/households/$(hid);
    }

    function isMember(hid) {
      return signedIn()
        && exists(householdPath(hid))
        && request.auth.uid in get(householdPath(hid)).data.memberUids;
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Beitritt: Ein Nicht-Mitglied darf nur seine eigene uid hinzufügen und muss dabei einen
    // gültigen, noch unbenutzten Einladungscode für genau diesen Haushalt mitschreiben.
    function isJoining(hid) {
      let code = request.resource.data.inviteCode;
      let invitePath = /databases/$(database)/documents/invites/$(code);
      let invite = get(invitePath).data;
      return signedIn()
        && !(request.auth.uid in resource.data.memberUids)
        && onlyChanges(['memberUids', 'inviteCode'])
        && request.resource.data.memberUids.toSet() == resource.data.memberUids.toSet().union([request.auth.uid].toSet())
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
        && code is string
        && exists(invitePath)
        && invite.householdId == hid
        && invite.expiresAt > request.time
        && !('usedAt' in invite);
    }

    // Mitglieder dürfen den Haushalt bearbeiten. memberUids darf sich dabei nur ändern,
    // indem man sich selbst entfernt (Verlassen). Fremde hinzufügen geht nur per Einladung.
    function isMemberUpdate() {
      let before = resource.data.memberUids;
      let after = request.resource.data.memberUids;
      return signedIn()
        && request.auth.uid in before
        && (after == before
            || (after.toSet() == before.toSet().difference([request.auth.uid].toSet())
                && after.size() == before.size() - 1));
    }

    match /households/{hid} {
      // Lesen über resource.data, damit die Abfrage "memberUids array-contains uid" erlaubt ist.
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.activeModules is list;
      allow update: if isMemberUpdate() || isJoining(hid);
      allow delete: if false;

      // Nur Unterkollektionen: {document=**} allein würde in Rules v2 auch den Haushalt selbst treffen.
      match /{collection}/{document=**} {
        allow read, write: if isMember(hid);
      }
    }

    match /invites/{code} {
      // Einzelabruf per Code ist erlaubt (zum Beitreten), Auflisten nicht.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isMember(request.resource.data.householdId)
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(24, 'h')
        && !('usedAt' in request.resource.data);
      // Beim Beitritt wird der Code im selben Batch als benutzt markiert.
      allow update: if signedIn()
        && onlyChanges(['usedAt'])
        && !('usedAt' in resource.data)
        && request.auth.uid in getAfter(householdPath(resource.data.householdId)).data.memberUids;
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }
  }
}
